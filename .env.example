# Serein — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# Deployment and keeper keys are NOT read from here. They live in `.secrets/wallets.env`, which is
# generated locally by `pnpm wallets:generate`, is gitignored, and is never printed, committed, or
# sent anywhere. Only the public addresses are ever shared.

# ---------------------------------------------------------------------------------------------
# Required to deploy or run the keeper against Sepolia
# ---------------------------------------------------------------------------------------------

# A Sepolia JSON-RPC endpoint. Any provider works; Alchemy is what the deployment uses.
# Keep this secret: it is the app's server-side read endpoint, proxied through /api/rpc so the key
# is never shipped to a browser.
SEPOLIA_RPC_URL=

# ---------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------

# Etherscan API key, for automatic contract source verification after deploy.
ETHERSCAN_API_KEY=

# Seconds per draw. Short enough to demonstrate live, long enough that weights mean something.
SEREIN_DRAW_DURATION=900

# Participants per selection batch. 8 is the contract's hard ceiling; 5 stays under the global HCU
# limit even when the boundary cache is cold. See BENCHMARKS.md.
SEREIN_BATCH_SIZE=5

# Seconds between keeper passes.
SEREIN_KEEPER_INTERVAL=60

# ---------------------------------------------------------------------------------------------
# Web app (apps/web/.env.local, or Worker secrets in production)
# ---------------------------------------------------------------------------------------------

# WalletConnect project id. Optional — without it the app offers injected wallets only, and ships a
# tighter Content-Security-Policy because no WalletConnect origins need allowing.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
