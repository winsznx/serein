{
  "name": "@serein/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Serein protocol contracts — encrypted TWAB, exact weighted FHE selection, isolated prize reserve",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "hardhat compile --quiet && tsc --noEmit",
    "clean": "hardhat clean",
    "benchmark": "hardhat test test/benchmark.hcu.test.ts",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepolia",
    "proof:sepolia": "hardhat run scripts/live-proof.ts --network sepolia",
    "keeper:sepolia": "hardhat run scripts/keeper.ts --network sepolia"
  },
  "dependencies": {
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "encrypted-types": "^0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@serein/reference-model": "workspace:*",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.5",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "typechain": "^8.3.2",
    "@types/chai-as-promised": "^7.1.8",
    "chai-as-promised": "^7.1.2"
  }
}
